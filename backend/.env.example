# ==============================================================
# AI Derma Assistant — Backend Production Environment Template
# ==============================================================

# Server Configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,https://ai-derma-assistant.vercel.app

# Cloudinary Storage (Clinical images & Grad-CAM Heatmaps)
CLOUDINARY_CLOUD=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# OpenRouter / OpenAI API Key for Chat Triage
OPENAI_API_KEY=your_openrouter_or_openai_api_key

# Qdrant Vector Database
# Leave blank to use local storage (./qdrant_storage) or supply Qdrant Cloud credentials:
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Firebase Credentials
# Option 1: File path (Local / VM)
FIREBASE_CREDENTIALS_JSON_PATH=serviceAccountKey.json
# Option 2: Raw JSON string in environment (Render / Railway / Fly)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}
FIREBASE_STORAGE_BUCKET=dermascan-79a5c.firebasestorage.app

# ML Weights path (optional override)
# SKIN_MODEL_PATH=/app/weights/skin_model.pth

# External Services
GOOGLE_MAPS_API_KEY=your_google_maps_places_api_key
